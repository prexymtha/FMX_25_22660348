rets_xts <- return_mat %>%
tbl_xts(cols_to_xts = colnames(return_mat)[-1])
# Align weights to returns dates:
# Only have weights on rebalance dates; Return.portfolio will carry them
weights_xts_aligned <- weights_xts[index(weights_xts) %in% index(rets_xts), ]
# Portfolio construction script (R)
# Requirements implemented:
# - monthly data
# - exclude assets with <5 years returns
# - lookback >= 10 years (120 months) for mean/cov forecasts (but not earlier than 2011-01-01)
# - covariance estimated using data after 2010 (we restrict estimation period start to 2011-01-01)
# - quarterly rebalancing
# - long-only, single asset <= 35%, bonds <=25%, equities <=60%, commodities <=15%
# - monthly returns and portfolio performance computed
# ---- Packages ----
if(!require(tidyverse)) install.packages("tidyverse"); library(tidyverse)
if(!require(lubridate)) install.packages("lubridate"); library(lubridate)
if(!require(readr)) install.packages("readr"); library(readr)
if(!require(CVXR)) install.packages("CVXR"); library(CVXR)
if(!require(xts)) install.packages("xts"); library(xts)
if(!require(zoo)) install.packages("zoo"); library(zoo)
# ---- Read the data ----
# Update paths if needed
MAA <- readRDS("data/MAA.rds")
msci <- readRDS("data/msci.rds")
# Filter tickers/names as user indicated
MAA <- MAA %>% filter(Ticker %in% c("LUACTRUU Index", "LUAGTRUU Index", "BCOMTR Index", "LP05TREH Index"))
msci <- msci %>% filter(Name %in% c("MSCI ACWI", "MSCI USA", "MSCI RE", "MSCI Jap", "MSCI China"))
# ---- Harmonize and merge into monthly return series ----
# I assume MAA and msci contain price/total return series with a date column.
# If the structure differs, adapt the column names below.
# We'll try to be flexible: detect the date column and the value column(s).
# Helper to standardize format: returns a tibble with Date, Asset, Return
standardize_to_returns <- function(df, date.col = NULL, value.col = NULL, name.col = NULL, asset_name = NULL) {
# Try to auto-detect columns
if (is.null(date.col)) date.col <- names(df)[sapply(df, lubridate::is.Date) | grepl("date", names(df), ignore.case = TRUE)][1]
if (is.null(name.col)) {
if ("Ticker" %in% names(df)) name.col <- "Ticker"
if ("Name" %in% names(df)) name.col <- "Name"
}
if (is.null(value.col)) value.col <- names(df)[sapply(df, is.numeric)][1]
if (is.null(date.col) | is.null(value.col)) stop("Couldn't auto detect date/value column - pass them explicitly.")
df2 <- df %>%
rename(.date = !!sym(date.col), .value = !!sym(value.col)) %>%
mutate(.asset = if (!is.null(asset_name)) asset_name else (!!sym(name.col))) %>%
select(.date, .asset, .value)
return(df2)
}
# Try to standardize MAA and msci.
# You might need to change the auto-detection if your objects are differently structured.
MAA_std <- standardize_to_returns(MAA)
msci_std <- standardize_to_returns(msci)
# Combine
all_series <- bind_rows(MAA_std, msci_std)
# Turn to monthly returns: if .value is total return index / price, compute log returns month-to-month.
# Ensure date is Date type and floor to last day of month
all_series <- all_series %>%
mutate(.date = as.Date(.date)) %>%
mutate(month = floor_date(.date, unit = "month")) %>%
group_by(.asset, month) %>%
# take last observation in each month to get month-end level
summarise(level = last(.value, na.rm = TRUE), .groups = "drop") %>%
arrange(.asset, month)
# Convert to wide xts-like for returns calculation
wide_levels <- all_series %>% pivot_wider(names_from = .asset, values_from = level) %>% arrange(month)
dates <- wide_levels$month
wide_levels <- wide_levels %>% select(-month)
# compute monthly log returns
# if there are NAs at beginning for some assets that's ok; returns will be NA for first diff
ret_mat <- diff(log(as.matrix(wide_levels))) # differences across rows
ret_df <- as.data.frame(ret_mat)
ret_df$month <- dates[-1] # because diff reduces one observation
# ---- Remove assets with < 5 years returns data ----
min_months_required <- 5 * 12
asset_month_counts <- colSums(!is.na(ret_df %>% select(-month)))
keep_assets <- names(asset_month_counts)[asset_month_counts >= min_months_required]
if(length(keep_assets) == 0) stop("No assets with >= 5 years data - check your input files.")
ret_df <- ret_df %>% select(all_of(keep_assets), month)
# ---- Asset class mapping (you must adapt if your tickers differ) ----
# Map each asset to one of: Equities, Bonds, Commodities, Credit (treat credit as bonds for the 25% cap if appropriate)
# Edit to match the actual tickers you have
asset_class_map <- tibble(
asset = keep_assets,
class = case_when(
grepl("MSCI|RE|USA|Jap|China|ACWI", asset, ignore.case = TRUE) ~ "Equity",
grepl("LUACTRUU|LUAGTRUU|LP05TREH|TRE|TREH", asset, ignore.case = TRUE) ~ "Bond",
grepl("BCOMTR|BCOM", asset, ignore.case = TRUE) ~ "Commodity",
TRUE ~ "Equity"  # default to Equity if unknown — change this to correct mapping
)
)
# Check mapping
print(asset_class_map)
# ---- Settings for lookback and estimation windows ----
lookback_months <- 120 # 10 years
cov_estimation_start <- as.Date("2011-01-01") # use data after 2010 for covariance estimation
# Convert ret_df to xts-like for easy subsetting by date
ret_xts <- ret_df %>% arrange(month)
dates_all <- ret_xts$month
R_all <- ret_xts %>% select(-month) %>% as.matrix()
rownames(R_all) <- as.character(dates_all)
# ---- Quarterly rebalancing schedule ----
# Choose rebalancing dates as the last trading month of each quarter that has enough lookback data.
quarters_end <- dates_all[month(dates_all) %in% c(3,6,9,12)]
# Only keep quarter ends where we have at least lookback_months of data ending at that date
rebalance_dates <- quarters_end[which(sapply(quarters_end, function(d) {
# index of date
idx <- which(dates_all == d)
if (length(idx)==0) return(FALSE)
earliest_idx <- idx - lookback_months + 1
if (earliest_idx < 1) return(FALSE)
# also ensure covariance estimation uses data after 2010: require at least some data since 2011-01-01
return(TRUE)
}))]
# However we also must ensure covariance estimation period starts no earlier than 2011-01-01
# We'll implement lookback such that the window is the later of (d - 120 months +1) and 2011-01-01
rebalance_dates <- rebalance_dates
# ---- Optimization setup using CVXR ----
# For each rebalance date:
# - compute mu (mean monthly return) and Sigma (cov of monthly returns) from lookback window
# - solve: maximize mu' w - gamma * w' Sigma w
# - subject to: sum(w) == 1, w >= 0, w_i <= 0.35, class exposures <= caps
gamma <- 3  # risk aversion parameter: play with this (higher => more defensive). You can tune or set target return.
# Asset-class caps
caps <- list(Equity = 0.60, Bond = 0.25, Commodity = 0.15)
# Store outputs
weights_list <- list()
port_returns <- tibble(date = as.Date(character()), ret = numeric())
for (d in rebalance_dates) {
# Identify row index for date d
idx_d <- which(dates_all == d)
if (length(idx_d) == 0) next
# Define lookback start: 120 months back but not earlier than 2011-01-01
start_candidate_idx <- idx_d - lookback_months + 1
if (start_candidate_idx < 1) {
# not enough lookback - skip this rebalance
next
}
start_date <- dates_all[start_candidate_idx]
# Ensure start_date >= 2011-01-01 for covariance estimation. If earlier, set start_date to first date >= 2011-01-01
cov_start_date <- max(start_date, cov_estimation_start)
# adjust indices
start_idx_cov <- which(dates_all >= cov_start_date)[1]
if (is.na(start_idx_cov) || start_idx_cov >= idx_d) next
# Subset returns for lookback window for means (we'll use last 120 months for means, but for cov use >=2011)
mu_window_idx <- (start_candidate_idx):(idx_d - 1) # returns indexed by rows (note returns are dated at month t for return from t-1->t)
cov_window_idx <- start_idx_cov:(idx_d - 1)
# if indices invalid skip
if (min(mu_window_idx) < 1) next
# create matrices
R_mu <- R_all[mu_window_idx, , drop = FALSE]
R_cov <- R_all[cov_window_idx, , drop = FALSE]
# Remove columns with too many NAs inside window (should already have filtered assets <5 years)
na_perc_mu <- colMeans(is.na(R_mu))
assets_ok <- names(na_perc_mu)[na_perc_mu < 0.2] # require at least 80% non-NA in the window
if (length(assets_ok) == 0) next
R_mu <- R_mu[, assets_ok, drop = FALSE]
R_cov <- R_cov[, assets_ok, drop = FALSE]
mu <- colMeans(R_mu, na.rm = TRUE) # monthly expected return
Sigma <- cov(R_cov, use = "pairwise.complete.obs")
n <- length(mu)
# CVXR variables
w <- Variable(n)
# Objective: maximize mu' w - gamma * w' Sigma w
objective <- Maximize( t(mu) %*% w - gamma * quad_form(w, Sigma) )
# Constraints:
constr <- list()
constr <- c(constr, list( sum_entries(w) == 1 ))
constr <- c(constr, list( w >= 0 ))
constr <- c(constr, list( w <= 0.35 ))
# Asset class constraints
# build class exposure matrix
asset_names <- colnames(R_mu)
classes <- asset_class_map %>% filter(asset %in% asset_names) %>% pull(class)
# For any asset missing mapping, default to Equity
if(length(classes) != n) {
classes <- sapply(asset_names, function(a) {
ans <- asset_class_map$class[asset_class_map$asset == a]
if(length(ans)==0) "Equity" else ans
})
}
for (cl in unique(classes)) {
cap <- caps[[cl]]
if (is.null(cap)) next
idxs <- which(classes == cl)
if(length(idxs) > 0) {
e <- rep(0, n); e[idxs] <- 1
constr <- c(constr, list( t(e) %*% w <= cap ))
}
}
prob <- Problem(objective, constr)
result <- solve(prob, solver = "SCS") # or ECOS_BB, OSQP; try alternatives if fails
if (result$status != "optimal" && result$status != "optimal_inaccurate") {
warning(paste("Optimization not optimal at", d, "status:", result$status))
next
}
w_opt <- as.vector(result$getValue(w))
names(w_opt) <- asset_names
# Save
weights_list[[as.character(d)]] <- w_opt
# Compute portfolio returns until next rebalance (quarterly)
# find next rebalance date index
next_idx_in_quarters <- which(rebalance_dates > d)
if(length(next_idx_in_quarters) == 0) {
# last rebalance: compute returns until end of R_all
out_idx <- (idx_d):(nrow(R_all))
} else {
next_d <- rebalance_dates[next_idx_in_quarters[1]]
next_idx <- which(dates_all == next_d)
out_idx <- (idx_d):(next_idx - 1)
}
# For monthly returns, we need the returns rows that correspond to months after the rebalance
# R_all rows correspond to return at date dates_all (same as ret_df$month)
# The weight determined at date d applies to returns for the following months until next rebalance
ret_indices <- which(dates_all %in% dates_all[out_idx])
# For safety select actual sequence:
ret_indices <- out_idx
# compute portfolio returns for each month in that span (use asset names aligned with w_opt)
R_sub <- R_all[ret_indices, asset_names, drop = FALSE]
monthly_port_rets <- as.vector( R_sub %*% w_opt )
dates_port <- dates_all[ret_indices]
port_returns <- bind_rows(port_returns, tibble(date = dates_port, ret = monthly_port_rets))
}
# ---- Summarize results ----
# weights_list: named list by rebalance date
# port_returns: monthly returns series for portfolio
# Convert weights_list to a data frame
weights_df <- bind_rows(lapply(names(weights_list), function(nm) {
w <- weights_list[[nm]]
tibble(rebalance = as.Date(nm), asset = names(w), weight = as.numeric(w))
}), .id = NULL)
# show last weights
last_weights <- weights_df %>% filter(rebalance == max(rebalance)) %>% arrange(desc(weight))
#-------------------------------------------------------------------
# 1. Load & combine MSCI + MAA into a unified df_full
#-------------------------------------------------------------------
# Load your data
msci <- read_rds("data/msci.rds")
MAA  <- read_rds("data/MAA.rds")
df_full <- bind_rows(
msci %>% rename(Tickers = Name),
MAA %>% select(-Name) %>% rename(Tickers = Ticker)
) %>%
arrange(date)
#-------------------------------------------------------------------
# 2. Build monthly returns & filter by data availability
#-------------------------------------------------------------------
monthly_df <- df_full %>%
filter(date >= ymd(20100101)) %>%
mutate(YM = format(date, "%Y%B")) %>%
arrange(date) %>%
group_by(Tickers, YM) %>%
filter(date == last(date)) %>%
ungroup() %>%
group_by(Tickers) %>%
arrange(date) %>%
mutate(ret = Price / lag(Price) - 1) %>%
ungroup() %>%
filter(!is.na(ret))
# Filter assets with >= 60 monthly obs
eligible_tickers <- monthly_df %>%
group_by(Tickers) %>%
summarise(n_months = n(), .groups = "drop") %>%
filter(n_months >= 60) %>%
pull(Tickers)
monthly_df <- monthly_df %>%
filter(Tickers %in% eligible_tickers)
# Wide return matrix
return_mat <- monthly_df %>%
select(date, Tickers, ret) %>%
pivot_wider(names_from = Tickers, values_from = ret) %>%
arrange(date)
# Numeric matrix for optimisation
return_mat_Nodate <- data.matrix(return_mat[, -1])
dates_vec <- return_mat$date
#-------------------------------------------------------------------
# 3. Asset classes & constraint structure
#-------------------------------------------------------------------
assets <- colnames(return_mat_Nodate)
asset_classes <- tibble(
asset = assets,
class = case_when(
asset %in% c("LUACTRUU Index", "LUAGTRUU Index", "LP05TREH Index") ~ "bond",
asset %in% c("BCOMTR Index") ~ "commodity",
TRUE ~ "equity"
)
)
print(asset_classes)
#-------------------------------------------------------------------
# 4. Estimate µ and Σ using available data
#-------------------------------------------------------------------
# FIX 1: Use sample covariance or check available types
Sigma_full <- cov(return_mat_Nodate, use = "complete.obs")
# FIX 2: Calculate mean returns
Mu_full <- colMeans(return_mat_Nodate, na.rm = TRUE)
# Alternative: If you want to use RiskPortfolios, check available types:
# Try one of these: "naive", "ewma", "lw", "rblw", "factor"
# Sigma_full <- RiskPortfolios::covEstimation(return_mat_Nodate, control = list(type = "naive"))
#-------------------------------------------------------------------
# 5. Single-period optimiser function (keep your existing function)
#-------------------------------------------------------------------
optim_foo <- function(Sigma, Mu, asset_classes,
LB = 0, UB = 0.35,
bond_UB = 0.25, eq_UB = 0.60, comm_UB = 0.15) {
stopifnot(length(Mu) == ncol(Sigma))
N <- length(Mu)
bond_idx <- which(asset_classes$class == "bond")
eq_idx <- which(asset_classes$class == "equity")
comm_idx <- which(asset_classes$class == "commodity")
one_vec <- rep(1, N)
I_N <- diag(N)
A_full <- cbind(one_vec, I_N, -I_N)
b_full <- c(1, rep(LB, N), rep(-UB, N))
A_bond <- rep(0, N); if (length(bond_idx) > 0) A_bond[bond_idx] <- -1
A_eq <- rep(0, N); if (length(eq_idx) > 0) A_eq[eq_idx] <- -1
A_comm <- rep(0, N); if (length(comm_idx) > 0) A_comm[comm_idx] <- -1
A_groups <- cbind(A_bond, A_eq, A_comm)
b_groups <- c(
if (length(bond_idx) > 0) -bond_UB else 0,
if (length(eq_idx) > 0) -eq_UB else 0,
if (length(comm_idx) > 0) -comm_UB else 0
)
Amat <- cbind(A_full, A_groups)
bvec <- c(b_full, b_groups)
meq <- 1
Dmat <- as.matrix(Sigma)
diag(Dmat) <- diag(Dmat) + 1e-8
w.opt <- solve.QP(
Dmat = Dmat,
dvec = Mu,
Amat = Amat,
bvec = bvec,
meq = meq
)$solution
tibble(
stocks = asset_classes$asset,
weight = as.numeric(w.opt)
)
}
# Test single-period optimization
result_static <- optim_foo(Sigma_full, Mu_full, asset_classes)
print(result_static)
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE, fig.width = 6, fig.height = 5, fig.pos="H", fig.pos = 'H')
