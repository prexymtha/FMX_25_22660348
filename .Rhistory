# 3D array of correlations: dimension is usually [N, N, T]
Rho_array <- rcor(fit.gogarch)
# Check the series names
colnames(xts_rtn)
# should be: "ZAR", "Carry", "Value", "DXY"
# Build a tidy tibble with ZAR's correlations vs Carry, Value and DXY
rho_df <- tibble(
date      = zoo::index(xts_rtn),
ZAR_Carry = as.numeric(Rho_array["ZAR",   "Carry", ]),
ZAR_Value = as.numeric(Rho_array["ZAR",   "Value", ]),
ZAR_DXY   = as.numeric(Rho_array["ZAR",   "DXY",   ])
) %>%
pivot_longer(-date, names_to = "Pair", values_to = "Rho")
