pacman::p_load(dplyr, tibble, PerformanceAnalytics, fmxdat, zoo)
BM_name    <- "Benchmark"
fund_names <- c("ABC_Fund", "Peer_Average")
Moments_ABC <- function(returns_xts, years) {
end_date   <- zoo::index(returns_xts)[NROW(returns_xts)]
start_date <- fmxdat::safe_year_min(end_date, N = years)
sub_xts <- returns_xts[paste0(start_date, "/")]
Fundxts <- sub_xts[, fund_names]
BMxts   <- sub_xts[, BM_name, drop = FALSE]
Moms <-
dplyr::bind_rows(
data.frame(Return.cumulative(Fundxts))                        %>% round(3),
data.frame(Return.annualized(Fundxts, scale = 12))            %>% round(3),
data.frame(Return.annualized.excess(Fundxts, BMxts))          %>% round(3),
data.frame(sd.annualized(Fundxts, scale = 12))                %>% round(3),
data.frame(AdjustedSharpeRatio(Fundxts))                      %>% round(3),
data.frame(PainIndex(Fundxts, scale = 12))                    %>% round(3),
data.frame(AverageDrawdown(Fundxts, scale = 12))              %>% round(3),
data.frame(fmxdat::Safe_TE(Fundxts, BMxts, scale = 12))       %>% round(3),
data.frame(InformationRatio(Fundxts, BMxts))                  %>% round(3),
data.frame(CAPM.beta(Fundxts, BMxts, Rf = 0))                 %>% round(3),
data.frame(CAPM.beta.bull(Fundxts, BMxts, Rf = 0))            %>% round(3),
data.frame(CAPM.beta.bear(Fundxts, BMxts, Rf = 0))            %>% round(3),
data.frame(UpDownRatios(Fundxts, BMxts, method = "Percent",
side = "Up"))                         %>% round(3),
data.frame(CVaR(Fundxts, p = 0.05, method = "modified"))      %>% round(3)
) %>%
tibble::rownames_to_column("Info") %>%      # keep all rows, whatever the package returns
mutate(
Period = paste0("Last ", years, " Years")
) %>%
dplyr::relocate(Period, .before = Info)
colnames(Moms) <- gsub("\\.", " ", colnames(Moms))
Moms
}
