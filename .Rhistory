pacman::p_load(tidyverse, rugarch, rmgarch, tbl2xts, lubridate, PerformanceAnalytics, fmxdat, readr, forecast, MTS, robustbase)
# Load and prepare data
cncy <- read_rds("data/currencies.rds")
Carry <- read_rds("data/cncyCarry.rds")
