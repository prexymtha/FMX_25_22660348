# Load readr for rds data sets
pacman::p_load(readr)
# Load the data
Benchmark <- read_rds("data/Capped_SWIX.rds")
Active_Managers <- read_rds("data/Active_Managers.rds")
ABC_Fund <- read_rds("data/ABC_Fund.rds")
# Load required packages
pacman::p_load(tidyverse, tbl2xts, PerformanceAnalytics)
# 1.1 Combine all funds into one tibble
df_all <- bind_rows(
Benchmark %>% select(date, Name, Returns),
Active_Managers %>% select(date, Name, Returns),
ABC_Fund %>% select(date, Name, Returns)
)
# 1.2 Filter out missing values and convert to xts
xts_rets <- df_all %>%
arrange(date) %>%
tbl_xts(cols_to_xts = Returns, spread_by = Name)
# Quick check
head(xts_rets)
colnames(xts_rets)
## 2.1 Histogram (with normal line)
chart.Histogram(
xts_rets$ABC_Fund,
methods = "add.normal",
main = "ABC Fund: Histogram of monthly returns"
)
## 2.2 Histogram with density, normal and VaR
chart.Histogram(
xts_rets$ABC_Fund,
methods = c("add.density", "add.normal", "add.risk"),
main = "ABC Fund: Returns with VaR (95%)"
)
## 2.3 Boxplot
chart.Boxplot(
xts_rets$ABC_Fund,
main = "ABC Fund: Boxplot of monthly returns"
)
## 2.4 QQ plot against Normal
chart.QQPlot(
xts_rets$ABC_Fund,
distribution = "norm",
main = "ABC Fund: QQ Plot vs Normal"
)
## 2.5 Drawdowns from the return series
chart.Drawdown(
xts_rets$ABC_Fund,
main = "Drawdowns: ABC Fund",
col  = "steelblue"
)
## 2.6 Cumulative returns (growth of 1)
chart.CumReturns(
xts_rets$ABC_Fund,
main = "Cumulative Returns: ABC Fund",
col  = "steelblue"
)
# Merge the series and remove NAs
xts_rets <- na.omit(merge(
ABC_Fund = xts_rets$ABC_Fund,
FTSE_JSE = xts_rets$FTSE.JSE.Capped.SWIX
))
# Check the result
dim(xts_rets)
head(xts_rets)
# Now create the scatter plot
chart.Scatter(
x = xts_rets$ABC_Fund,
y =xts_rets$FTSE.JSE.Capped.SWIX,
main = "Scatter: ABC Fund vs FTSE/JSE Capped SWIX",
col = "steelblue",
xlab = "ABC Fund return",
ylab = "Capped SWIX return"
)
Sel <- c("ABC_Fund", "FTSE.JSE.Capped.SWIX", "A1", "B2", "C3")
chart.RiskReturnScatter(
R = xts_rets[, Sel],
main = "Risk–return scatter: ABC, Benchmark and selected managers"
)
chart.RollingPerformance(
R    = xts_rets['2012-07-31/'][, c("ABC_Fund", "A1", "B2")],
FUN  = "sd",
width = 36,                        # 36 months rolling window
main  = "Rolling 36-month standard deviation",
legend.loc = "bottomleft"
)
glimpse(xts_rets)
View(xts_rets)
# Merge the series and remove NAs
xts_rets_changed <- na.omit(merge(
ABC_Fund = xts_rets$ABC_Fund,
FTSE_JSE = xts_rets$FTSE.JSE.Capped.SWIX
))
# Check the result
dim(xts_rets_changed)
head(xts_rets_changed)
# Now create the scatter plot
chart.Scatter(
x = xts_rets_changed$ABC_Fund,
y = xts_rets_changed$FTSE.JSE.Capped.SWIX,
main = "Scatter: ABC Fund vs FTSE/JSE Capped SWIX",
col = "steelblue",
xlab = "ABC Fund return",
ylab = "Capped SWIX return"
)
# Merge the series and remove NAs
xts_rets_changed <- na.omit(merge(
ABC_Fund = xts_rets$ABC_Fund,
FTSE_JSE = xts_rets$FTSE.JSE.Capped.SWIX
))
