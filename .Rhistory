dim(xts_rets)
# Check if NAs are in the same rows
na_abc <- is.na(xts_rets$ABC_Fund)
na_ftse <- is.na(xts_rets$FTSE.JSE.Capped.SWIX)
# See if NA patterns differ
sum(na_abc)
sum(na_ftse)
sum(na_abc & na_ftse)  # Both NA
sum(na_abc | na_ftse)  # Either NA
# Find rows where one has NA but the other doesn't
which(na_abc != na_ftse)
# Merge the series and remove NAs
aligned_data <- na.omit(merge(
ABC_Fund = xts_rets$ABC_Fund,
FTSE_JSE = xts_rets$FTSE.JSE.Capped.SWIX
))
# Check the result
dim(aligned_data)
head(aligned_data)
# Now create the scatter plot
chart.Scatter(
x = aligned_data$ABC_Fund,
y = aligned_data$FTSE_JSE,
main = "Scatter: ABC Fund vs FTSE/JSE Capped SWIX",
col = "steelblue",
xlab = "ABC Fund return",
ylab = "Capped SWIX return"
)
