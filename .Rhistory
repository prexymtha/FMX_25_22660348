filter(!is.na(Carry)) %>%
select(date, Carry)
value_rts <- cncy_value %>%
arrange(date) %>%
mutate(Value = log(Price) - log(lag(Price))) %>%
filter(!is.na(Value)) %>%
select(date, Value)
dxy_rts <- bbdxy %>%
arrange(date) %>%
mutate(DXY = log(Price) - log(lag(Price))) %>%
filter(!is.na(DXY)) %>%
select(date, DXY)
