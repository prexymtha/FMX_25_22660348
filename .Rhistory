# Calculate returns in FMX style
calculate_returns <- function(data) {
data %>%
gather(Currency, Price, -Date) %>%
group_by(Currency) %>%
arrange(Date) %>%
mutate(
dlogret = log(Price) - log(lag(Price)),
scaledret = (dlogret - mean(dlogret, na.rm = TRUE))
) %>%
filter(Date > first(Date)) %>%
ungroup()
}
# Prepare currency returns
currency_returns <- calculate_returns(cncy)
zar_returns <- currency_returns %>% filter(Currency == "ZAR") %>% tbl_xts(cols_to_xts = "dlogret")
