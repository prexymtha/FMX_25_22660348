# Load Packages
pacman::p_load(pacman)
p_load("PerformanceAnalytics", "RcppRoll", "tbl2xts",
"fmxdat", "tidyverse")
# Load data
Benchmark <- read_rds("data/Capped_SWIX.rds")
Active_Managers <- read_rds("data/Active_Managers.rds")
ABC_Fund <- read_rds("data/ABC_Fund.rds")
## Benchmark fund
Benchmark_roll <- Benchmark %>% arrange(date) %>%
group_by(Name) %>%
mutate(bench_roll = roll_prod(1+Returns, 36,
fill = NA, align = "right")^(12/36) - 1) %>%
group_by(date, Name) %>% filter(any(!is.na(bench_roll))) %>%
ungroup() %>%
mutate(Y = format(date, "%Y")) %>% select(date, Y, bench_roll)
## Active Funds
Active_Managers_roll <- Active_Managers %>% arrange(date) %>%
group_by(Name) %>%
mutate(active_roll = roll_prod(1+Returns, 36,
fill = NA, align = "right")^(12/36) - 1) %>%
group_by(date, Name) %>% filter(any(!is.na(active_roll))) %>%
ungroup() %>%
mutate(Y = format(date, "%Y")) %>% select(date, Y, Name, active_roll)
## ABC_Fund
ABC_Fund_roll <- ABC_Fund %>% arrange(date) %>%
group_by(Name) %>%
mutate(ABC_roll = roll_prod(1+Returns, 36,
fill = NA, align = "right")^(12/36) - 1) %>%
group_by(date, Name) %>% filter(any(!is.na(ABC_roll))) %>%
ungroup() %>%
mutate(Y = format(date, "%Y")) %>% select(date, Y, ABC_roll)
AM_Beta <- Active_Managers_roll %>%
left_join(Benchmark_roll, by = c("date", "Y")) %>%
group_by(Y, Name) %>%
summarise(AM_Beta = coef(lm(active_roll ~ bench_roll))[2])
ABC_Beta <- ABC_Fund_roll %>%
left_join(Benchmark_roll, by = c("date", "Y")) %>%
group_by(Y) %>%
summarise(ABC_Beta = coef(lm(ABC_roll ~ bench_roll))[2])
Main_box <- AM_Beta %>% left_join(ABC_Beta, by = c("Y")) %>% select(-Name) %>%
filter(Y >= 2016)
Main_box_plot <- Main_box %>% ggplot +
geom_boxplot(aes(y = Y, x = AM_Beta), col = "darkslategray",
fill = "lightblue", width = 0.5) +
labs(title = "Comparison of 3-Year Rolling Beta Estimates Between Active Funds and The ABC Fund",
subtitle = "", y = "", x = "Rolling 3-Year Beta",
caption = "Note:\nThe orange diamond represents The ABC Fund's 3-Year Rolling Beta.\nThe boxplots represent the Beta's of Active managers throughout repective periods") +
theme_fmx(title.size = ggpts(30), subtitle.size = ggpts(5),
caption.size = ggpts(25), CustomCaption = T) +
scale_x_continuous(breaks = seq(from = - 8.0, to = 3.0, by = 1.0)) +
geom_point(aes(y = Y, x = ABC_Beta), col = "#FF4500", size = 3,
shape = 18)
Main_box_plot
Avg_AM_ROll <- Active_Managers_roll %>% group_by(date) %>%
summarise(active_roll_mean = mean(active_roll))
Main_Roll <- ABC_Fund_roll %>%
left_join(Avg_AM_ROll, by = "date") %>% select(-Y) %>%
left_join(Benchmark_roll, by = "date") %>% select(-Y) %>%
pivot_longer(cols = -date, names_to = "Fund",
values_to = "Roll_Returns") %>%
arrange(date)
Main_Roll_plot <- Main_Roll %>% ggplot() +
geom_line(aes(x = date, y = Roll_Returns, col = Fund), size = 1) +
fmx_cols() +
labs(title = "Comparative Rolling 3-year returns:",
subtitle = "ABC Fund vs Mean Active Manager return",
x = "", x = "3-year rolling return") +
theme(legend.position = "bottom",
panel.grid.major = element_blank()
) +
theme_fmx(title.size = ggpts(30), subtitle.size = ggpts(25),
caption.size = ggpts(25), CustomCaption = F)
Main_Roll_plot
