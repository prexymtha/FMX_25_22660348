## -----------------------------------------------------------
## Purpose: General statistics table for ABC vs Benchmark vs Peers
## -----------------------------------------------------------
## Assumes you already have:
## returns_xts with columns: "Benchmark", "ABC_Fund", "Peer_Average"
## monthly data
## -----------------------------------------------------------
pacman::p_load(
dplyr,
tibble,
PerformanceAnalytics,
fmxdat,
tbl2xts,
gt,
glue,
zoo
)
BM_name    <- "Benchmark"
fund_names <- c("ABC_Fund", "Peer_Average")
## -----------------------------------------------------------
## Safe TE reminder:
## -----------------------------------------------------------
## Do NOT use TrackingError directly when dates do not align.
## Here we work on a single, common xts object (returns_xts),
## and then use fmxdat::Safe_TE on that aligned sample.
## -----------------------------------------------------------
Moments_ABC <- function(returns_xts, BM_name, fund_names, Yrs_LookBack) {
# Define start and end of look-back period
end_date   <- zoo::index(returns_xts)[NROW(returns_xts)]
start_date <- fmxdat::safe_year_min(datesel = end_date, N = Yrs_LookBack)
sub_xts <- returns_xts[paste0(start_date, "/")]
# Funds to analyse vs benchmark
Fundxts <- sub_xts[, fund_names]
BMxts   <- sub_xts[, BM_name, drop = FALSE]
# Ensure PerformanceAnalytics is loaded
library(PerformanceAnalytics)
# Up–Down ratios can return multiple rows; we only want the main one
UD_full <- data.frame(
PerformanceAnalytics::UpDownRatios(
Ra     = Fundxts,
Rb     = BMxts,
method = "Percent",
side   = "Up"
)
) %>% round(3)
UD <- UD_full[1, , drop = FALSE]
Moms <-
dplyr::bind_rows(
data.frame(Return.cumulative(Fundxts))                               %>% round(3),
data.frame(Return.annualized(Fundxts, scale = 12, geometric = TRUE)) %>% round(3),
data.frame(Return.annualized.excess(Fundxts, BMxts))                 %>% round(3),
data.frame(sd.annualized(Fundxts, scale = 12, geometric = TRUE))     %>% round(3),
data.frame(AdjustedSharpeRatio(Fundxts))                              %>% round(3),
data.frame(PainIndex(Fundxts, scale = 12, geometric = TRUE))         %>% round(3),
data.frame(AverageDrawdown(Fundxts, scale = 12))                     %>% round(3),
data.frame(fmxdat::Safe_TE(Ra = Fundxts, Rb = BMxts, scale = 12))    %>% round(3),
data.frame(InformationRatio(Ra = Fundxts, Rb = BMxts))               %>% round(3),
data.frame(CAPM.beta(Ra = Fundxts, Rb = BMxts, Rf = 0))              %>% round(3),
data.frame(CAPM.beta.bull(Ra = Fundxts, Rb = BMxts, Rf = 0))         %>% round(3),
data.frame(CAPM.beta.bear(Ra = Fundxts, Rb = BMxts, Rf = 0))         %>% round(3),
UD,
data.frame(CVaR(R = Fundxts, p = 0.05, method = "modified"))         %>% round(3)
) %>%
tibble::rownames_to_column("Info") %>%
mutate(
Period = glue::glue("Last {Yrs_LookBack} Years"),
Info   = c(
"Cum Returns",
"Returns (Ann.)",
"Returns Excess (Ann.)",
"SD (Ann.)",
"Adj. Sharpe Ratio",
"Pain Index",
"Avg DD",
"Tracking Error",
"Information Ratio",
"Beta",
"Beta Bull",
"Beta Bear",
"Up-Down Ratio",
"Modified CVaR"
)
) %>%
dplyr::relocate(Period, .before = Info)
# Replace dots in column names with spaces
colnames(Moms) <- gsub("\\.", " ", colnames(Moms))
Moms
}
## -----------------------------------------------------------
## Build combined stats table (e.g. Last 3 and Last 5 Years)
## -----------------------------------------------------------
Tab_stats_ABC <-
dplyr::bind_rows(
Moments_ABC(returns_xts, BM_name, fund_names, Yrs_LookBack = 3),
Moments_ABC(returns_xts, BM_name, fund_names, Yrs_LookBack = 5)
)
Benchmark       <- read_rds("data/Capped_SWIX.rds")
Active_Managers <- read_rds("data/Active_Managers.rds")
ABC_Fund        <- read_rds("data/ABC_Fund.rds")
## -----------------------------------------------------------
## Dispersion of Active Managers vs Benchmark (Monthly data)
## -----------------------------------------------------------
pacman::p_load(
tidyverse,
lubridate,
RcppRoll,
fmxdat,
ggplot2
)
# Active manager panel: rename to match Nico's style
df_stocks <-
Active_Managers %>%
transmute(
date,
Tickers = Name,     # manager name
Return  = Returns   # manager return
)
# Benchmark returns
BM <-
Benchmark %>%
arrange(date) %>%
transmute(
date,
BM = Returns
)
# Generic dispersion function (NSel in *months* now)
Dispersion_Prep <- function(df_used, BMUse, NSel = 36, CapDisp = 0.45) {
# 1) Winsorise manager returns at +/- 50% and drop missing
df_use <-
df_used %>%
filter(date >= ymd(20050101)) %>%               # longish sample, adjust if needed
mutate(
Return = ifelse(Return >  0.5,  0.5, Return),
Return = ifelse(Return < -0.5, -0.5, Return)
) %>%
filter(!is.na(Return))
# 2) Compute rolling manager returns over NSel months
df_mgr_roll <-
df_use %>%
group_by(Tickers) %>%
arrange(date) %>%
mutate(
roll_Rt = RcppRoll::roll_prod(1 + Return, n = NSel,
fill = NA, align = "right") - 1
) %>%
ungroup()
# 3) Compute rolling benchmark return over same window
df_bm_roll <-
BMUse %>%
arrange(date) %>%
mutate(
roll_BM = RcppRoll::roll_prod(1 + BM, n = NSel,
fill = NA, align = "right") - 1
) %>%
select(date, roll_BM) %>%
distinct()
# 4) Join and compute cross-sectional dispersions
Roll_M_disp <-
df_mgr_roll %>%
left_join(df_bm_roll, by = "date") %>%
filter(!is.na(roll_Rt), !is.na(roll_BM)) %>%
group_by(date) %>%
summarise(
# Equal-weight dispersion around cross-sectional mean
Dispersion_U = {
mu_cs <- mean(roll_Rt, na.rm = TRUE)
sqrt(mean((roll_Rt - mu_cs)^2, na.rm = TRUE))
},
# Equal-weight dispersion around benchmark’s own rolling return
Dispersion_W = sqrt(mean((roll_Rt - roll_BM)^2, na.rm = TRUE)),
.groups = "drop"
) %>%
mutate(
N    = NSel,
type = glue::glue("Managers (N = {NSel}m)")
) %>%
mutate(
across(starts_with("Dispersion"),
~ ifelse(. > CapDisp, CapDisp, .))
)
Roll_M_disp
}
# Example: Rolling 3-year and 1-year dispersion of active managers
disp_36m <- Dispersion_Prep(df_used = df_stocks, BMUse = BM, NSel = 36, CapDisp = 0.45)
disp_12m <- Dispersion_Prep(df_used = df_stocks, BMUse = BM, NSel = 12, CapDisp = 0.45)
# 3-year dispersion graph
gdisp_36m <-
disp_36m %>%
pivot_longer(
cols      = starts_with("Dispersion"),
names_to  = "Type",
values_to = "Value"
) %>%
ggplot(aes(x = date, y = Value, colour = Type)) +
geom_line() +
fmxdat::theme_fmx() +
fmxdat::fmx_cols() +
labs(
x = "",
y = "Rolling 3-year active return dispersion",
title = "Dispersion of active manager 3-year returns vs benchmark"
)
fmxdat::finplot(
gdisp_36m,
y.pct     = TRUE,
y.pct_acc = 1,
x.date.dist = "2 years",
x.date.type = "%Y",
x.vert      = TRUE
)
# 1-year dispersion graph (if you want a shorter horizon too)
gdisp_12m <-
disp_12m %>%
pivot_longer(
cols      = starts_with("Dispersion"),
names_to  = "Type",
values_to = "Value"
) %>%
ggplot(aes(x = date, y = Value, colour = Type)) +
geom_line() +
fmxdat::theme_fmx() +
fmxdat::fmx_cols() +
labs(
x = "",
y = "Rolling 1-year active return dispersion",
title = "Dispersion of active manager 1-year returns vs benchmark"
)
fmxdat::finplot(
gdisp_12m,
y.pct     = TRUE,
y.pct_acc = 1,
x.date.dist = "2 years",
x.date.type = "%Y",
x.vert      = TRUE
)
## -----------------------------------------------------------
## Proportion of active managers outperforming vs dispersion
## -----------------------------------------------------------
pacman::p_load(dplyr, lubridate, RcppRoll, fmxdat)
# Align BM on year-month (avoid 28th vs 29th issue)
BMUse <-
Benchmark %>%
arrange(date) %>%
mutate(YM = format(date, "%Y%B")) %>%
group_by(YM) %>%
filter(date == last(date)) %>%
ungroup() %>%
arrange(date) %>%
mutate(BM = Returns)
# Join managers to BM by YM
active_df <-
Active_Managers %>%
mutate(YM = format(date, "%Y%B")) %>%
left_join(
BMUse %>% select(YM, BM),
by = "YM"
)
# Rolling 12-month relative performance of each manager vs BM
df_comp <-
active_df %>%
group_by(Name) %>%
arrange(date) %>%
mutate(
RollRet = RcppRoll::roll_prod(1 + Returns, n = 12,
fill = NA, align = "right"),
RollBM  = RcppRoll::roll_prod(1 + BM,      n = 12,
fill = NA, align = "right")
) %>%
ungroup() %>%
filter(!is.na(RollRet)) %>%
mutate(XS = RollRet - RollBM) %>%
group_by(date) %>%
summarise(
Proportion = mean(XS > 0, na.rm = TRUE),  # share of managers beating BM
.groups    = "drop"
)
# Combine with 3-year dispersion series
df_comp_plot <-
left_join(
df_comp %>%
mutate(YM = format(date, "%Y%B")),
disp_36m %>%
mutate(YM = format(date, "%Y%B")) %>%
group_by(YM) %>%
filter(date == last(date)) %>%
ungroup() %>%
select(YM, Disp = Dispersion_W),
by = "YM"
)
# Stratify into High / Low / Other dispersion environments
df_comp_plot %>%
filter(!is.na(Disp)) %>%
mutate(
hidisp = quantile(Disp, 0.85, na.rm = TRUE),
lodisp = quantile(Disp, 0.25, na.rm = TRUE),
Enviro = case_when(
Disp > hidisp ~ "Hi",
Disp < lodisp ~ "Low",
TRUE          ~ "Other"
)
) %>%
group_by(Enviro) %>%
summarise(
prop = mean(Proportion, na.rm = TRUE),
.groups = "drop"
)
