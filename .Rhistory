ABC_Fund %>%
ggplot(aes(x = date, y = Returns)) +
geom_line(colour = "steelblue") +
labs(
title = "ABC Fund: Monthly returns",
x = "",
y = "Return"
) +
theme_fmx()
ABC_Fund %>%
ggplot(aes(x = Returns)) +
geom_histogram(bins = 30, colour = "white", fill = "steelblue") +
labs(
title = "ABC Fund: Distribution of monthly returns",
x = "Return",
y = "Count"
) +
theme_fmx()
df_all %>%
ggplot(aes(x = Name, y = Returns)) +
geom_boxplot(outlier.alpha = 0.3) +
labs(
title = "Boxplots of returns: ABC, Capped SWIX and active managers",
x = "",
y = "Monthly return"
) +
theme_fmx() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
cum_rets <-
df_all %>%
arrange(date) %>%
group_by(Name) %>%
mutate(
Returns = coalesce(Returns, 0),
Cum_Ret = cumprod(1 + Returns)
) %>%
ungroup()
cum_rets %>%
ggplot(aes(x = date, y = Cum_Ret, colour = Name)) +
geom_line(alpha = 0.8, linewidth = 1.1) +
labs(
title = "Cumulative returns: ABC Fund, Benchmark and managers",
x = "",
y = "Growth of 1"
) +
fmx_cols() +
theme_fmx()
